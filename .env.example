# Supabase Configuration (REQUIRED)
# Get these from: https://app.supabase.com/project/_/settings/api

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://ajxkrseogzecazdlprnd.supabase.co"

# Supabase Anon Key (safe to expose, read-only access)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Optional: Direct Database URL (only needed for Prisma migrations, not runtime)
DATABASE_URL="postgresql://postgres.ajxkrseogzecazdlprnd:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# App URL (for signal catching scripts)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API Keys for Signal Catching (optional)
NEWS_API_KEY=""  # Get from https://newsapi.org/
APIFY_API_KEY=""  # Get from https://apify.com/ (for LinkedIn scraping)

# Webhook Security (optional but recommended)
WEBHOOK_SECRET="your-webhook-secret-here"

# Cron Secret (optional)
CRON_SECRET="your-secret-here"

# Slack Integration (optional)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
